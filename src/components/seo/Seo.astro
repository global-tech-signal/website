---
import siteData from "../../data/siteData.json";
import jsonLDGenerator from "../../utils/jsonLD";

type Props = {
  title: string;
  description: string;
  url: string;
  image?: { src: string; alt: string };
  robots?: boolean;
  frontmatter?: any;
};

const {
  title,
  description,
  url = Astro.url,
  image,
  frontmatter,
  robots,
} = Astro.props;

const siteUrl = import.meta.env.SITE || "https://globaltechsignal.com";

const rawUrl = url ? url.toString() : Astro.url.toString();
const canonicalUrlObj = new URL(rawUrl, siteUrl);
if (canonicalUrlObj.pathname.length > 1 && canonicalUrlObj.pathname.endsWith("/")) {
  canonicalUrlObj.pathname = canonicalUrlObj.pathname.slice(0, -1);
}
const canonicalUrl = canonicalUrlObj.toString();

const getAbsoluteUrl = (path?: string) => {
  if (!path) return siteUrl;
  if (path.startsWith("http://") || path.startsWith("https://")) return path;
  return new URL(path, siteUrl).toString();
};

const rawImageSrc = image?.src || (frontmatter?.image ? `/blog/${frontmatter.image}` : siteData.image.src);
const ogImage = getAbsoluteUrl(rawImageSrc);

const jsonLD = jsonLDGenerator({
  type: frontmatter ? "post" : "website",
  post: frontmatter,
  url: canonicalUrl,
});
---

<!-- SEO -->
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph -->
<meta property="og:site_name" content="GlobalTechSignal" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:url" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={image?.alt || frontmatter?.title || siteData.image.alt} />

<!-- Twitter -->
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:domain" content={siteUrl.replace(/^https?:\/\//, '')} />

<!-- Robots Meta -->
<meta name="robots" content={robots ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />

<link rel="sitemap" href="/sitemap-index.xml" />
<!-- JSON LD -->
<Fragment set:html={jsonLD} />

